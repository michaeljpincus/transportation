write.csv(data, "data.csv", row.names = FALSE)
library(ggplot2)
df <- read.csv("data.csv")
# Heavy-rail stations only (hrt_d = 1), with positive ridership so the log is defined
hrt <- subset(df, hrt_d == 1 & rider > 0)
hrt$ln_rider <- log(hrt$rider)
# Side-by-side histograms (base R)
par(mfrow = c(1, 2))
hist(hrt$rider,    breaks = 30, col = "steelblue",
main = "Heavy-rail station ridership", xlab = "Ridership")
hist(hrt$ln_rider, breaks = 30, col = "steelblue",
main = "Natural log of ridership",     xlab = "ln(Ridership)")
par(mfrow = c(1, 1))
# Or with ggplot2
ggplot(hrt, aes(rider)) + geom_histogram(bins = 30, fill = "steelblue", color = "white") +
labs(title = "Heavy-rail station ridership", x = "Ridership", y = "Stations")
ggplot(hrt, aes(ln_rider)) + geom_histogram(bins = 30, fill = "steelblue", color = "white") +
labs(title = "Natural log of heavy-rail station ridership", x = "ln(Ridership)", y = "Stations")
# Numbers to support your description
summary(hrt$rider);    sd(hrt$rider)
summary(hrt$ln_rider); sd(hrt$ln_rider)
View(hh)
library(ggplot2)
df  <- read.csv("data.csv")
hrt <- subset(df, hrt_d == 1)
# Base R
plot(hrt$jobs_halfmile, hrt$rider,
xlab = "Jobs within a half mile", ylab = "Station ridership",
main = "Heavy-rail ridership vs. nearby jobs",
pch = 19, col = rgb(0.27, 0.51, 0.71, 0.6))
abline(lm(rider ~ jobs_halfmile, data = hrt), col = "red", lwd = 2)
# ggplot2
ggplot(hrt, aes(x = jobs_halfmile, y = rider)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_smooth(method = "lm", se = FALSE, color = "red") +
labs(title = "Heavy-rail ridership vs. nearby jobs",
x = "Jobs within a half mile", y = "Station ridership")
# Optional: log-log version, since both variables are likely skewed
ggplot(subset(hrt, rider > 0 & jobs_halfmile > 0),
aes(x = log(jobs_halfmile), y = log(rider))) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_smooth(method = "lm", se = FALSE, color = "red") +
labs(x = "ln(Jobs within a half mile)", y = "ln(Station ridership)")
# Correlation
cor(hrt$jobs_halfmile, hrt$rider, use = "complete.obs")
df  <- read.csv("data.csv")
hrt <- subset(df, hrt_d == 1)
# Linear model
m1 <- lm(rider ~ pop_halfmile + jobs_halfmile + terminal_d + airport_d, data = hrt)
summary(m1)
confint(m1)
# Optional: log-log version (continuous variables logged; dummies left as is)
hrt_pos <- subset(hrt, rider > 0 & pop_halfmile > 0 & jobs_halfmile > 0)
m2 <- lm(log(rider) ~ log(pop_halfmile) + log(jobs_halfmile) + terminal_d + airport_d,
data = hrt_pos)
summary(m2)
# Optional: side-by-side table
# install.packages("stargazer")
library(stargazer)
stargazer(m1, m2, type = "text")
df  <- read.csv("data.csv")
df  <- read.csv("data.csv")
hrt <- subset(df, hrt_d == 1)
# Linear model
m1 <- lm(rider ~ pop_halfmile + jobs_halfmile + terminal_d + airport_d, data = hrt)
summary(m1)
new_station <- data.frame(
pop_halfmile  = 5000,
jobs_halfmile = 10000,
terminal_d    = 0,
airport_d     = 0
)
# Linear model (m1) prediction, with 95% prediction interval
predict(m1, newdata = new_station, interval = "prediction", level = 0.95)
# Residuals vs. fitted values for the linear model (m1)
diag1 <- data.frame(fitted = fitted(m1), resid = resid(m1))
ggplot(diag1, aes(x = fitted, y = resid)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_hline(yintercept = 0, color = "red", linetype = "dashed") +
geom_smooth(se = FALSE, color = "darkorange", method = "loess", formula = y ~ x) +
labs(title = "Residuals vs. predicted ridership (linear model)",
x = "Predicted ridership", y = "Residual")
View(m1)
library(ggplot2)
df  <- read.csv("data.csv")
hrt <- subset(df, hrt_d == 1 & rider > 0 & pop_halfmile > 0 & jobs_halfmile > 0)
# Log-log regression (dummies left untransformed)
m_log <- lm(log(rider) ~ log(pop_halfmile) + log(jobs_halfmile) + terminal_d + airport_d,
data = hrt)
summary(m_log)
# Residuals vs. predicted ln(ridership)
diag_log <- data.frame(fitted = fitted(m_log), resid = resid(m_log))
ggplot(diag_log, aes(x = fitted, y = resid)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_hline(yintercept = 0, color = "red", linetype = "dashed") +
geom_smooth(se = FALSE, color = "darkorange", method = "loess", formula = y ~ x) +
labs(title = "Residuals vs. predicted ln(ridership)",
x = "Predicted ln(ridership)", y = "Residual")
# Prediction for 5,000 residents, 10,000 jobs, non-terminal, non-airport
new_station <- data.frame(pop_halfmile = 5000, jobs_halfmile = 10000,
terminal_d = 0, airport_d = 0)
pred_ln <- predict(m_log, newdata = new_station)
exp(pred_ln)                                    # naive back-transform
exp(pred_ln) * mean(exp(residuals(m_log)))      # with smearing correction
ggplot(diag1, aes(x = fitted, y = resid)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_hline(yintercept = 0, color = "red", linetype = "dashed") +
labs(title = "Residuals vs. predicted ridership (linear model)",
x = "Predicted ridership", y = "Residual")
ggplot(diag_log, aes(x = fitted, y = resid)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_hline(yintercept = 0, color = "red", linetype = "dashed") +
labs(title = "Residuals vs. predicted ln(ridership)",
x = "Predicted ln(ridership)", y = "Residual")
View(why_tbl)
df  <- read.csv("data.csv")
hrt <- subset(df, hrt_d == 1 & rider > 0 & pop_halfmile > 0 & jobs_halfmile > 0)
# Log-log regression with park-and-ride indicator added (dummies not logged)
m_log2 <- lm(log(rider) ~ log(pop_halfmile) + log(jobs_halfmile) +
terminal_d + airport_d + parking_d,
data = hrt)
summary(m_log2)
confint(m_log2)
# Compare to the model without parking
anova(m_log, m_log2)
AIC(m_log, m_log2)
