### Assignment 5 - Michael Pincus
library(tidyverse)
library(readxl)
library(ggplot2)
library(showtext)
font_add_google("Roboto", "roboto")
showtext_auto()
hh <- readr::read_csv("Household travel survey/1_Household_Public.csv", locale = readr::locale(encoding = "latin1"))
per <- readr::read_csv("Household travel survey/2_Person_Public.csv", locale = readr::locale(encoding = "latin1"))
veh <- readr::read_csv("Household travel survey/3_Vehicle_Public.csv", locale = readr::locale(encoding = "latin1"))
trip <- readr::read_csv("Household travel survey/4_Trip_Public.csv", locale = readr::locale(encoding = "latin1"))
hh_dict <- read_excel('dd.xlsx', sheet='1 Household')
per_dict <- read_excel('dd.xlsx', sheet='2 Person')
veh_dict <- read_excel('dd.xlsx', sheet='3 Vehicle')
trip_dict <- read_excel('dd.xlsx', sheet='4 Trip')
View(hh)
View(trip)
View(per)
ggplot(per) +
geom_histogram(P_TOT_TRIP)
View(per)
ggplot(per) +
geom_histogram(P_TOT_TRIPS)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS))
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=10)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=15)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=20)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=22)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=30)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=20)
# Question 1
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=15)
ggplot(per) +
geom_histogram(aes(x=P_TOT_TRIPS), bins=15) +
theme_minimal()
per$no_trips <- ifelse(per$P_TOTAL_TRIPS == 0, 1, 0)
per$no_trips <- as.integer(per$P_TOTAL_TRIPS == 0)
per$no_trips <- ifelse(per$P_TOT_TRIPS == 0, 1, 0)
sum(per$no_trips, na.rm = TRUE)   # count
table(per$no_trips)               # counts for both groups
prop.table(table(per$no_trips))   # shares
View(trip_dict)
write.csv(trip_dict, "output.csv", row.names = FALS
View(trip_dict)
write.csv(trip_dict, "output.csv", row.names = FALSE)
View(veh)
write.csv(per_dict, "output.csv", row.names = FALSE)
# 1. Recode missing codes to NA
per <- per %>%
mutate(
AGECAT = ifelse(AGECAT %in% c(98, 99), NA, AGECAT),
RACE   = ifelse(RACE   %in% c(98, 99, 988), NA, RACE)
)
# 2. Indicator: 1 = no trips, 0 = at least one trip
per$no_trips <- ifelse(per$P_TOT_TRIPS == 0, 1, 0)
# 3. How many took no trips?
table(per$no_trips, useNA = "ifany")
sum(per$no_trips, na.rm = TRUE)
# 4. Add readable labels
per <- per %>%
mutate(
RACE_lab = factor(RACE,
levels = c(1, 2, 3, 4, 5, 6, 97, 100),
labels = c("White", "Black", "Hispanic/Latino", "Am. Indian/Alaska Native",
"Asian", "Pacific Islander", "Other", "Multi-race")),
AGE_lab = factor(AGECAT, levels = 1:12,
labels = c("<=5", "6-12", "13-15", "16-17", "18-24", "25-34",
"35-44", "45-54", "55-64", "65-74", "75-85", "86+"))
)
# 5. Compare groups (column %: share of each group in each category)
round(prop.table(table(per$RACE_lab, per$no_trips), margin = 2), 3)
round(prop.table(table(per$AGE_lab,  per$no_trips), margin = 2), 3)
# 6. Income: join from the household table (name yours; check names(hh))
per <- per %>% left_join(hh %>% select(HH_ID, INCOME), by = "HH_ID")
round(prop.table(table(per$INCOME, per$no_trips), margin = 2), 3)
View(per)
View(per_dict)
View(trip_dict)
library(dplyr)
# Labels from the dictionary
whyno_labels <- c(
"1"  = "Personally sick",
"2"  = "Vacation or personal day",
"3"  = "Caretaking sick kids",
"4"  = "Caretaking sick other",
"5"  = "Homebound elderly or disabled",
"6"  = "Worked at home for pay",
"7"  = "Not scheduled to work",
"8"  = "Worked around home (not for pay)",
"9"  = "No transportation available",
"10" = "Out of Delaware Valley region",
"11" = "Weather",
"12" = "No reason to travel",
"97" = "Other",
"98" = "Don't know",
"99" = "Refused"
)
# One record per person who did not travel (replace `trip` with your trip data frame's name)
no_travel <- trip %>%
filter(TRIP_NUM == 0) %>%
distinct(PERSON_ID, .keep_all = TRUE)
# Unweighted table: share of non-travelers giving each reason
why_tbl <- no_travel %>%
mutate(Reason = factor(WHYNO,
levels = as.numeric(names(whyno_labels)),
labels = whyno_labels)) %>%
count(Reason, name = "People") %>%
mutate(Percent = round(100 * People / sum(People), 1)) %>%
arrange(desc(People))
why_tbl            # full table
head(why_tbl, 5)   # five most common reasons
View(why_tbl)
