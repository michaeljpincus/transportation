### Assignment 5
library(tidyverse)
library(readxl)
hh <- readr::read_csv("Household travel survey/1_Household_Public.csv", locale = readr::locale(encoding = "latin1"))
per <- readr::read_csv("Household travel survey/2_Person_Public.csv", locale = readr::locale(encoding = "latin1"))
veh <- readr::read_csv("Household travel survey/3_Vehicle_Public.csv", locale = readr::locale(encoding = "latin1"))
trip <- readr::read_csv("Household travel survey/4_Trip_Public.csv", locale = readr::locale(encoding = "latin1"))
hh_dict <- read_excel('dd.xlsx', sheet='1 Household')
per_dict <- read_excel('dd.xlsx', sheet='2 Person')
veh_dict <- read_excel('dd.xlsx', sheet='3 Vehicle')
trip_dict <- read_excel('dd.xlsx', sheet='4 Trip')
# Question 1
q1_hh <- hh |>
filter(HH_ID==388636)
q1_per <- per |>
filter(HH_ID==388636)
q1_veh <- veh |>
filter(HH_ID==388636)
q1_trip <- trip |>
filter(HH_ID==388636)
# Question 2
bike_df <- trip |>
filter(MODE_AGG == 02)
total_bike_trips <- sum(bike_df$P_WEIGHT)
# Question 3
total_travel_time <- sum(trip$Model_TravTime * trip$P_WEIGHT, na.rm=TRUE)
person_time <- trip |>
group_by(PERSON_ID, P_WEIGHT) |>
summarise(daily_tt = sum(as.numeric(Model_TravTime), na.rm = TRUE),
.groups = "drop")
avg_tt_per_person <- weighted.mean(person_time$daily_tt, person_time$P_WEIGHT)
# Question 4
person_bike <- trip |>
group_by(PERSON_ID, P_WEIGHT) |>
summarise(bike_tt = sum(as.numeric(Survey_TravTime)[MODE_AGG==02], na.rm = TRUE),
.groups = "drop")
avg_bike_per_person <- weighted.mean(person_bike$bike_tt, person_bike$P_WEIGHT)
bike_tt_pct <- (sum(bike_df$Model_TravTime * bike_df$P_WEIGHT, na.rm=TRUE) / total_travel_time) * 100
bike_trips_pct <- (total_bike_trips / sum(trip$P_WEIGHT) ) * 100
# Question 5
total_bike_hrs_value <- (sum(bike_df$Model_TravTime, na.rm=TRUE) / 60) * 35
total_trips_hrs_value <- (total_travel_time/60) * 35
# Question 7
q7_hh <- hh |> x
### Assignment 5
library(tidyverse)
library(readxl)
hh <- readr::read_csv("Household travel survey/1_Household_Public.csv", locale = readr::locale(encoding = "latin1"))
per <- readr::read_csv("Household travel survey/2_Person_Public.csv", locale = readr::locale(encoding = "latin1"))
veh <- readr::read_csv("Household travel survey/3_Vehicle_Public.csv", locale = readr::locale(encoding = "latin1"))
trip <- readr::read_csv("Household travel survey/4_Trip_Public.csv", locale = readr::locale(encoding = "latin1"))
hh_dict <- read_excel('dd.xlsx', sheet='1 Household')
per_dict <- read_excel('dd.xlsx', sheet='2 Person')
veh_dict <- read_excel('dd.xlsx', sheet='3 Vehicle')
trip_dict <- read_excel('dd.xlsx', sheet='4 Trip')
q1_hh <- hh |>
filter(HH_ID==388636)
q1_per <- per |>
filter(HH_ID==388636)
q1_veh <- veh |>
filter(HH_ID==388636)
veh_joined <- left_join(veh, income, by ='HH_ID')
veh_joined <- veh_joined |>
filter(!is.na(INCOME))
# Question 8
veh <- veh |>
mutate(YEAR = if_else(YEAR %in% c(9998, 9999), NA_real_, YEAR)) |>
mutate(VEH_AGE = 2012 - YEAR)
income <- hh |>
select(HH_ID, INCOME)
income <- income |>
mutate(INCOME = if_else(INCOME %in% c(98, 99), NA_real_, INCOME))
veh_joined <- left_join(veh, income, by ='HH_ID')
veh_joined <- veh_joined |>
filter(!is.na(INCOME))
veh_joined <- veh_joined |>
mutate(INCOME_F = factor(INCOME,
levels = 1:10,
labels = c("$0 to $9,999", "$10,000 to $24,999",
"$25,000 to $34,999", "$35,000 to $49,999",
"$50,000 to $74,999", "$75,000 to $99,999",
"$100,000 to $149,999", "$150,000 to $199,999",
"$200,000 to $249,999", "$250,000 or more"),
ordered = TRUE))
ggplot(veh_joined, aes(x = INCOME_F, y = VEH_AGE)) +
geom_boxplot(na.rm = TRUE, outlier.alpha = 0.2) +
coord_flip() +
labs(x = "Household income", y = "Vehicle age (years)") +
theme_minimal()
trip_joined <- left_join(trip, income, by = 'HH_ID')
trip_joined$MODE_F <- factor(
trip_joined$MODE_AGG,
levels = 1:7,
labels = c("Walk", "Bike", "Private Vehicle", "Private Transit",
"Public Transit", "School Bus", "Other")
)
trip_joined <- trip_joined |>
mutate(INCOME_F = factor(INCOME,
levels = 1:10,
labels = c("$0 to $9,999", "$10,000 to $24,999",
"$25,000 to $34,999", "$35,000 to $49,999",
"$50,000 to $74,999", "$75,000 to $99,999",
"$100,000 to $149,999", "$150,000 to $199,999",
"$200,000 to $249,999", "$250,000 or more"),
ordered = TRUE))
library(scales)
ggplot(subset(trip_joined, !is.na(INCOME_F) & !is.na(MODE_F)),
aes(x = INCOME_F, fill = MODE_F)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = percent) +
labs(x = "Household income", y = "Share of trips", fill = "Mode") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
library(showtext)
font_add_google("Roboto", "roboto")
showtext_auto()
ggplot(subset(trip_joined, !is.na(INCOME_F) & !is.na(MODE_F)),
aes(x = INCOME_F, fill = MODE_F)) +
geom_bar(position = "fill") +
scale_y_continuous(labels = percent) +
labs(x = "Household income", y = "Share of trips", fill = "Mode") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
ggplot(subset(trip_joined, !is.na(INCOME_F) & !is.na(MODE_F)),
